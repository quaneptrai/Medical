# ============================================================
# Phong kham YG - Environment template
# Copy this file to ".env" and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
# The real ".env" is git-ignored and must never be committed.
# ============================================================

# --- Compute device for the embedding model -----------------
# cpu  = works everywhere (default, first query takes ~40s to warm up)
# cuda = requires an NVIDIA GPU AND a CUDA build of torch
BOTMED_DEVICE=cpu

# --- LLM provider (only used by scripts/ CLI tools) ---------
# The web app does NOT call an LLM. Leave these alone unless you
# run scripts\test_chat.py / scripts\run_golden_eval.py.
# ollama = local model, gemini = Google API, auto = gemini then ollama
BOTMED_LLM_PROVIDER=ollama
BOTMED_OLLAMA_BASE_URL=http://localhost:11434/v1
BOTMED_OLLAMA_MODEL=llama3.1:8b

# Required only when BOTMED_LLM_PROVIDER is gemini or auto
GEMINI_API_KEY=

# --- Frontend -> Backend link -------------------------------
# Change only if you start the FastAPI backend on another host/port.
BOTMED_BACKEND_URL=http://127.0.0.1:8000
